# =============================================
# CWCU SIAKAD + E-Learning Environment Config
# =============================================

# App
APP_ENV=development
APP_PORT=8080
APP_NAME=CWCU

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=cwcu_user
DB_PASSWORD=cwcu_password
DB_NAME=cwcu_db
DB_SSLMODE=disable

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# LavinMQ (AMQP)
AMQP_URL=amqp://cwcu_user:cwcu_password@lavinmq:5672/

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=https://s3.samuelms.web.id
MINIO_USER=cwcu_admin
MINIO_PASSWORD=cwcu_password123
MINIO_BUCKET=cwcu-documents
MINIO_USE_SSL=false

# CORS
CORS_ALLOWED_ORIGINS=https://siakad.samuelms.web.id,http://localhost:5173,http://localhost:80
